<schemalist gettext-domain="wetter@mlkonrad.github.com">
  <enum id="org.gnome.shell.extensions.wetter.position">
    <value nick="center" value="0" />
    <value nick="right" value="1" />
    <value nick="left" value="2" />
  </enum>
  <enum id="org.gnome.shell.extensions.wetter.time-format">
    <value nick="auto" value="0" />
    <value nick="12h" value="1" />
    <value nick="24h" value="2" />
  </enum>
  <schema id="org.gnome.shell.extensions.wetter" path="/org/gnome/shell/extensions/wetter/">
    <key name="city" type="av">
      <default>[]</default>
      <summary>Cities to be displayed</summary>
    </key>
    <key name="actual-city" type="i">
      <default>0</default>
      <summary>Currently selected city</summary>
      <description>Index into the "city" list, or -1 to select the current-location entry (see "use-current-location").</description>
    </key>
    <key name="use-current-location" type="b">
      <default>false</default>
      <summary>Use current location</summary>
      <description>Detect the current location via GeoClue and offer it as a selectable, auto-refreshing entry alongside manually-added cities.</description>
    </key>
    <key name="current-location-city" type="av">
      <default>[]</default>
      <summary>Cached current-location city</summary>
      <description>Serialized GWeather.Location for the most recently resolved current-location city (holds zero or one entries).</description>
    </key>
    <key name="use-symbolic-icons" type="b">
      <default>true</default>
      <summary>Use symbolic icons</summary>
    </key>
    <key name="show-text-in-panel" type="b">
      <default>true</default>
      <summary>Show temperature in panel</summary>
    </key>
    <key name="show-trend-in-panel" type="b">
      <default>false</default>
      <summary>Show temperature trend in panel</summary>
      <description>Show an arrow next to the panel temperature when the next few hours get noticeably warmer or colder.</description>
    </key>
    <key name="show-comment-in-panel" type="b">
      <default>false</default>
      <summary>Show conditions in panel</summary>
    </key>
    <key name="show-humidity-in-panel" type="b">
      <default>false</default>
      <summary>Show humidity in panel</summary>
    </key>
    <key name="show-wind-in-panel" type="b">
      <default>false</default>
      <summary>Show wind speed in panel</summary>
    </key>
    <key name="position-in-panel" enum="org.gnome.shell.extensions.wetter.position">
      <default>'center'</default>
      <summary>Position in panel</summary>
    </key>
    <key name="wind-direction" type="b">
      <default>true</default>
      <summary>Wind direction by arrows</summary>
      <description>Choose whether to display wind direction through arrows or letters.</description>
    </key>
    <key name="show-feels-like" type="b">
      <default>true</default>
      <summary>Show "Feels like" in details</summary>
    </key>
    <key name="show-visibility" type="b">
      <default>true</default>
      <summary>Show visibility in details</summary>
    </key>
    <key name="show-humidity" type="b">
      <default>true</default>
      <summary>Show humidity in details</summary>
    </key>
    <key name="show-pressure" type="b">
      <default>true</default>
      <summary>Show pressure in details</summary>
    </key>
    <key name="show-wind" type="b">
      <default>true</default>
      <summary>Show wind in details</summary>
    </key>
    <key name="show-daily-forecast" type="b">
      <default>true</default>
      <summary>Show daily forecast</summary>
    </key>
    <key name="forecast-days" type="i">
      <range min="1" max="10"/>
      <default>5</default>
      <summary>Number of forecast days to show</summary>
    </key>
    <key name="show-hourly-forecast" type="b">
      <default>true</default>
      <summary>Show hour-by-hour forecast</summary>
    </key>
    <key name="hourly-forecast-count" type="i">
      <range min="1" max="48"/>
      <default>24</default>
      <summary>Number of hours to show in the hour-by-hour forecast</summary>
    </key>
    <key name="notify-precipitation" type="b">
      <default>false</default>
      <summary>Notify before rain, snow or thunderstorms</summary>
      <description>Show a notification when the hourly forecast for the selected location has rain, snow or a thunderstorm coming within the next two hours.</description>
    </key>
    <key name="time-format" enum="org.gnome.shell.extensions.wetter.time-format">
      <default>'auto'</default>
      <summary>Time format</summary>
      <description>Choose 12-hour, 24-hour, or automatic (follow the system clock format) time display.</description>
    </key>
  </schema>
</schemalist>
